{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OopsLauncher",
  "version": "0.4.30",
  "identifier": "com.oopslauncher.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node scripts/sv-tag.js && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "OopsLauncher",
        "width": 1200,
        "height": 800,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMDAxQzI2OTE1MEM3QjkKUldTNXgxQ1JKaHdBWHFXOG84WFgwa0s1dU94elBwazhkc1NYbHB3SXRvZzNoRGl2ZnZiRFh0aFgK",
      "endpoints": [
        "https://github.com/object-1ve/OopsLauncher/releases/latest/download/latest.json"
      ]
    }
  }
}
